# DocuQuery Environment Variables
# Groq is the primary provider. OpenAI is only used as a fallback if Groq fails.
# With neither key set the app still runs, but in offline mode (answers are built
# straight from the retrieved chunks instead of an LLM).

GROQ_API_KEY=your_groq_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
